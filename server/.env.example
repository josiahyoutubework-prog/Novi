# Copy this file to `.env` and fill in your key to turn on real Novi AI.
# Without a key, Novi runs on its built-in deterministic engine (still fully functional).

# Your Anthropic API key (https://console.anthropic.com/ → API Keys).
ANTHROPIC_API_KEY=

# Optional — the model Novi uses. Defaults to claude-opus-5.
# NOVI_MODEL=claude-opus-5
